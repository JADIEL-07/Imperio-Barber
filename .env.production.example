# Producción / Despliegue
ENVIRONMENT=production
DEBUG=False

# Base de datos
POSTGRES_USER=imperio_prod_user
POSTGRES_PASSWORD=generate_a_secure_strong_password_here_1234!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Nombres de bases de datos
AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
BOOKING_DB_NAME=booking_db

# Seguridad y Sesión (Secreto mínimo de 32 caracteres)
SESSION_SECRET=super_secure_production_secret_key_minimum_32_characters_random_string

# Frontend Next.js
NODE_ENV=production
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_USE_MOCKS=false
PORT=80
