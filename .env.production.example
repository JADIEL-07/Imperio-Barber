# Producción / Despliegue en Coolify
# Estas son EXACTAMENTE las variables que docker-compose.yml sustituye
# (grep -oE '\$\{[A-Z_]+' docker-compose.yml). No agregues DATABASE_URL,
# CATALOG_SERVICE_URL ni AUTH_SERVICE_URL: el compose ya los arma solo
# con los nombres de los contenedores.
#
# Genera valores nuevos para los dos secretos antes de desplegar, no
# reutilices los de este archivo de ejemplo (el repo es público):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD
#   python -c "import secrets; print(secrets.token_hex(32))"       # SESSION_SECRET

POSTGRES_USER=imperio_admin
POSTGRES_PASSWORD=CAMBIA_ESTE_VALOR
SESSION_SECRET=CAMBIA_ESTE_VALOR_32_BYTES_EN_HEX

ENVIRONMENT=production

# --- Dominio único (recomendado, el que usa este proyecto) ---
# El dominio público va SOLO en el servicio "gateway" dentro de Coolify,
# puerto 80 (no le pongas dominio a "web" - queda interno). El gateway
# ya sirve "/" -> frontend y "/api/*" -> los 3 microservicios.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_USE_MOCKS=false
# No hace falta tocar CORS_ORIGINS (mismo origen, sin cross-site).

# --- Alternativa: dos dominios separados (frontend y backend distintos) ---
# Domain A (ej. app.tudominio.com) -> servicio "web", puerto 3000
# Domain B (ej. api.tudominio.com) -> servicio "gateway", puerto 80
# NEXT_PUBLIC_API_URL=https://api.tudominio.com/api
# CORS_ORIGINS=https://app.tudominio.com   # origen exacto del frontend, sin / final
